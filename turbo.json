{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#check:format": {
      "outputLogs": "new-only"
    },
    "//#check:knip": {
      "outputLogs": "new-only"
    },
    "//#check:lint": {
      "dependsOn": ["@gurgelio/react-map#build"],
      "outputLogs": "new-only"
    },
    "build": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only",
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "check": {
      "dependsOn": ["check:types", "//#check:lint", "//#check:format", "//#check:knip"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test"],
      "outputLogs": "new-only"
    },
    "test:ui": {
      "cache": false,
      "persistent": true
    },
    "transit": {},
    "check:types": {
      "dependsOn": ["^transit", "typegen"],
      "outputLogs": "new-only"
    },
    "typegen": {
      "inputs": ["src/app/**/{page,layout,route}.tsx", "next.config.ts"],
      "outputs": [".next/types/**", ".next/dev/types/**"]
    }
  }
}
