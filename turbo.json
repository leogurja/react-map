{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#format": {
      "outputLogs": "new-only"
    },
    "//#knip": {
      "outputLogs": "new-only"
    },
    "//#lint": {
      "dependsOn": ["^transit"],
      "outputLogs": "new-only"
    },
    "build": {
      "dependsOn": ["^build"],
      "outputLogs": "new-only",
      "outputs": ["dist/**", "storybook-static/**"]
    },
    "check": {
      "dependsOn": ["typecheck", "//#lint", "//#format", "//#knip"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "transit": {},
    "typecheck": {
      "dependsOn": ["^transit"],
      "outputLogs": "new-only"
    }
  }
}
