{
  "name": "react-map-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "A React component for displaying maps of countries and regions",
  "license": "MIT",
  "author": "Leonardo Gurgel <leo@gurgel.io>",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "check:format": "oxfmt .",
    "check:knip": "knip",
    "check:lint": "oxlint .",
    "check:types": "turbo run check:types",
    "clean": "turbo clean && rm -rf node_modules $HOME/.cache/biome",
    "postclean": "pnpm i",
    "dev": "turbo run dev",
    "format:fix": "oxfmt --fix .",
    "lint:fix": "oxlint --fix ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.9.1",
    "knip": "^6.15.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.5.0"
}
