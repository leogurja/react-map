{
  "name": "react-map-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "A React component for displaying maps of countries and regions",
  "license": "MIT",
  "author": "Leonardo Gurgel <leo@gurgel.io>",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "clean": "turbo clean && rm -rf node_modules $HOME/.cache/biome",
    "dev": "turbo run dev",
    "format": "oxfmt .",
    "format:fix": "oxfmt --fix .",
    "knip": "knip",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "postclean": "pnpm i",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "knip": "^6.15.0",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "turbo": "^2.9.16"
  },
  "packageManager": "pnpm@11.5.0"
}
